    "discover": "node scripts/discover.js",
    "probe": "node scripts/probe.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "serializd",
    "tv",
    "shows",
    "export",
    "backup",
    "scraping",
    "cli",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
