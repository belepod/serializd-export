  "description": "Export your serializd.com watch history (shows + diary) to JSON / CSV / Markdown / TXT. No native export? No problem.",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "serializd-export": "src/cli.js"
  },
  "scripts": {
